server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # AUTH_ORIGIN = the Cognito hosted-UI origin (token exchange from the browser); empty in local dev mode.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${AUTH_ORIGIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' ${AUTH_ORIGIN}; object-src 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /ws/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;   # always pick up a new build; nginx drops inherited headers here
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${AUTH_ORIGIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' ${AUTH_ORIGIN}; object-src 'none'" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }
    location / {
        try_files $uri /index.html;   # SPA routes, including the OIDC /callback
    }
}
