{
 "uid": "rpm-latency",
 "title": "RPM · latency and alerting",
 "tags": [
  "rpm"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Service levels · p95 latency over 5 min · counts over 1 h",
   "id": 1,
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Sensor→page",
   "id": 2,
   "description": "Sensor window end → care-team notification handed to the channel, for pages caused by a clinical event. Target < 5 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(histogram_quantile(0.95, sum by (le) (rate(rpm_page_latency_seconds_bucket{cause=\"event\"}[5m])))) >= 0",
     "legendFormat": "Sensor→page",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "noValue": "–",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#E0B400",
        "value": 5
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Home E2E",
   "id": 3,
   "description": "Window end on the watch/phone → scored by the stream engine (live data; backfill excluded).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(histogram_quantile(0.95, sum by (le) (rate(rpm_hop_latency_seconds_bucket{hop=\"end_to_end\",context=\"home\"}[5m])))) >= 0",
     "legendFormat": "Home E2E",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "noValue": "–",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#E0B400",
        "value": 3
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "ICU E2E",
   "id": 4,
   "description": "Window end at the ICU gateway → scored by the stream engine.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(histogram_quantile(0.95, sum by (le) (rate(rpm_hop_latency_seconds_bucket{hop=\"end_to_end\",context=\"icu\"}[5m])))) >= 0",
     "legendFormat": "ICU E2E",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "noValue": "–",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#E0B400",
        "value": 3
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Alerts 1h",
   "id": 5,
   "description": "New alerts (one active alert per patient; later events attach).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(increase(rpm_alerts_opened_total[1h]))",
     "legendFormat": "Alerts 1h",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "–",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Failed pages",
   "id": 6,
   "description": "Any failure is recorded per channel; the other channels still deliver.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(increase(rpm_notifications_total{status=\"failed\"}[1h])) or vector(0)",
     "legendFormat": "Failed pages",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "–",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "ICU backlog",
   "id": 7,
   "description": "Messages waiting in the gateway's durable outbox (grows while the cloud link is down).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(rpm_gw_outbox_depth) or vector(0)",
     "legendFormat": "ICU backlog",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "–",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#E0B400",
        "value": 50
       },
       {
        "color": "red",
        "value": 500
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "row",
   "title": "Latency",
   "id": 8,
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   }
  },
  {
   "type": "timeseries",
   "title": "End-to-end latency · home (watch / phone)",
   "id": 9,
   "description": "Sensor window end → processed. Separate panels, same meaning: compare them.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(rpm_hop_latency_seconds_bucket{hop=\"end_to_end\",context=\"home\"}[5m])))",
     "legendFormat": "p50",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(rpm_hop_latency_seconds_bucket{hop=\"end_to_end\",context=\"home\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p50"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7EB26D"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p95"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#1F78C1"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "End-to-end latency · ICU (bedside gateway)",
   "id": 10,
   "description": "Sensor window end → processed. Separate panels, same meaning: compare them.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(rpm_hop_latency_seconds_bucket{hop=\"end_to_end\",context=\"icu\"}[5m])))",
     "legendFormat": "p50",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(rpm_hop_latency_seconds_bucket{hop=\"end_to_end\",context=\"icu\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p50"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7EB26D"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p95"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#1F78C1"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "bargauge",
   "title": "Where the time goes · p95 per hop",
   "id": 11,
   "description": "edge = window end → sent by the device/gateway; uplink = sent → IoT ingest; pipeline = ingest → scored.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, hop, context) (rate(rpm_hop_latency_seconds_bucket{hop!=\"end_to_end\"}[5m])))",
     "legendFormat": "{{context}} · {{hop}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "#1F78C1"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Sensor → page p95 by channel",
   "id": 12,
   "description": "Pages caused by clinical events (timer, agent and manual pages measure dispatch delay instead).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(rpm_page_latency_seconds_bucket{cause=\"event\"}[5m])))",
     "legendFormat": "{{channel}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Notifications by status",
   "id": 13,
   "description": "Per minute. Skipped = channel not applicable (e.g. patient reassurance for ICU patients).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (status) (rate(rpm_notifications_total[5m])) * 60",
     "legendFormat": "{{status}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "sent"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "skipped"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8F8F8F"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "row",
   "title": "Agents",
   "id": 14,
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 22
   }
  },
  {
   "type": "timeseries",
   "title": "Agent runs per minute",
   "id": 15,
   "description": "Clinical events that reached the model.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (trigger) (rate(rpm_agent_runs_total[5m])) * 60",
     "legendFormat": "{{trigger}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
