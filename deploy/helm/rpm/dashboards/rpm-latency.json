   "id": 16,
   "description": "covered = a run on a more severe event of the same telemetry burst already saw it; debounced = same or lower severity within the debounce window.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 23
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (reason) (rate(rpm_agent_skipped_total[5m])) * 60",
     "legendFormat": "{{reason}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
