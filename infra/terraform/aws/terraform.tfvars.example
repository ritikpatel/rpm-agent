region             = "us-east-1"
environment        = "demo"
admin_cidrs        = ["203.0.113.10/32"] # your public IP; `curl -s ifconfig.me`
node_capacity_type = "ON_DEMAND"          # SPOT during development
budget_email       = "you@example.com"
budget_limit_usd   = 150

# ICU bedside gateway: false = pod on EKS (default), true = Greengrass v2 core on a t4g.small
# enable_greengrass_core = true
