%%{init: {"flowchart": {"wrappingWidth": 340}}}%%
flowchart TB
  subgraph SRC["1 · DATA SOURCES"]
    W["Wearable (Galaxy Watch app or simulator)<br/>discharged patients only<br/>heart rate, SpO2, activity"]
    ICU["ICU bedside monitor (simulated)<br/>admitted patients only<br/>HR, BP, SpO2, resp. rate, temp"]
    EHR["Hospital EHR and lab system<br/>admissions, discharges, labs, meds"]
  end

  subgraph ING["2 · INGESTION: one unified stream"]
    IOT["AWS IoT Core<br/>MQTT over TLS, one certificate per device"]
    FHIR["FHIR R4 server (HAPI FHIR)<br/>hospital integration layer,<br/>notifies on change (subscription)"]
    Q[["SQS queue: patient-events<br/>all sources in one event format"]]
  end

  subgraph RT["3 · REAL-TIME MONITORING AND RISK"]
    SP["Stream processor<br/>validate, store, NEWS2 score,<br/>alert rules, care-setting changes"]
    RS["Risk service: 3 model plug-ins<br/>early deterioration (Harnoor)<br/>readmission risk (Tiya)<br/>recovery monitoring (Navya)"]
  end

  subgraph ACT["4 · ALERTS AND AGENTIC AI"]
    API["Care API<br/>alerts, escalation timers, notifications,<br/>role-based access, audit log, agent tools"]
    subgraph AGS["Agent service (LangGraph, holds no patient data)"]
      direction LR
      A1["Monitoring agent<br/>what is happening?"] --> A2["Risk agent<br/>how serious is it?"] --> A3["Escalation agent<br/>who must act, how fast?"] --> A4["Summary agent<br/>cited SBAR report (RAG)"]
    end
    LLM["Amazon Bedrock<br/>Claude Sonnet 4.6 and Haiku 4.5 (agents)<br/>Titan Embeddings v2 (guideline search)"]
  end

  subgraph OUT["5 · CARE TEAM"]
    UI["Clinician console (web)<br/>live vitals, risk scores, alerts, summaries,<br/>patient messaging, audit trail"]
    USERS(["ICU physicians · emergency response team<br/>hospital clinicians · post-discharge providers"])
  end

  subgraph DATA["SHARED DATA"]
    DB[("PostgreSQL + pgvector<br/>vitals, scores, alerts,<br/>audit log, guideline index")]
    S3[("Amazon S3<br/>model files, guidelines,<br/>reports, audit archive")]
  end

  subgraph X["ACROSS EVERY LAYER"]
    SEC["Security and compliance<br/>Cognito sign-in and roles · TLS in transit<br/>KMS encryption at rest · full audit trail"]
    EVAL["Evaluation job (replays the dataset)<br/>model accuracy · alert latency · alert quality"]
  end

  subgraph KEY["COLOUR KEY"]
    K1["AWS managed service"]
    K2["Our container on k3s<br/>(Kubernetes on one EC2 instance)"]
    K3["Outside the platform"]
  end

  W <-->|"① vitals up,<br/>messages down"| IOT
  ICU -->|"① vitals"| IOT
  EHR -->|"① records and labs<br/>(FHIR)"| FHIR
  IOT -->|"② IoT rule"| Q
  FHIR -->|"② new lab, admission<br/>or discharge<br/>(via Care API hook)"| Q
  Q -->|"③ consume"| SP
  SP <-->|"④ score request,<br/>risk scores back"| RS
  SP --->|"⑤ alert: NEWS2<br/>or high risk"| API
  API -->|"⑥ live alert (WebSocket)<br/>+ e-mail page (SES)"| OUT
  UI --- USERS
  API <-->|"⑦ agent task (SQS)<br/>⑨ tool calls: read data,<br/>search guidelines,<br/>save summary, escalate"| AGS
  AGS <-->|"⑧ reason"| LLM
  IOT <-.->|"⑩ clinician and<br/>patient messages"| API
  FHIR <-.->|"results written<br/>back as FHIR"| API

  SP -.->|"store"| DB
  API <-.-> DB
  RS -.->|"read vitals,<br/>store scores"| DB
  RS -.->|"load models"| S3

  DB ~~~ SEC
  S3 ~~~ EVAL
  SEC ~~~ K1
  EVAL ~~~ K2

  classDef ext fill:#F3F4F6,stroke:#6B7280,color:#111827
  classDef aws fill:#FFF1DC,stroke:#D97706,color:#111827
  classDef k8s fill:#E0EDFF,stroke:#2563EB,color:#111827
  classDef note fill:#ECFDF5,stroke:#059669,color:#111827
  class W,ICU,EHR,USERS,K3 ext
  class IOT,Q,LLM,S3,K1 aws
  class FHIR,SP,RS,API,A1,A2,A3,A4,UI,DB,K2 k8s
  class SEC,EVAL note
